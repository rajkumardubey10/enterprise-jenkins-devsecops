pipeline {
    agent any

    tools {
        jdk 'JDK17'
        
    }

    stages {
        
        stage('Git Checkout') {
            steps {
                git branch: 'main', credentialsId: 'Github-token', url: 'https://github.com/rajkumardubey10/enterprise-jenkins-devsecops.git'
            }
        }
        
        stage('Download Signed Artifact from Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh '''
                        echo "Creating artifact directory..."
                        mkdir -p artifact
        
                        echo "Downloading signed JAR..."
        
                        curl -u "$NEXUS_USER:$NEXUS_PASS" \
                            -o artifact/app.jar \
                            "http://localhost:8081/repository/maven-snapshots/org/springframework/samples/spring-petclinic/4.0.0-SNAPSHOT/spring-petclinic-4.0.0-20260718.162536-1.jar"
        
                        echo "Downloading GPG signature..."
        
                        curl -u "$NEXUS_USER:$NEXUS_PASS" \
                            -o artifact/app.jar.asc \
                            "http://localhost:8081/repository/maven-snapshots/org/springframework/samples/spring-petclinic/4.0.0-SNAPSHOT/spring-petclinic-4.0.0-20260718.162536-1.jar.asc"
        
                        echo "Downloaded files:"
                        ls -lh artifact
                    '''
                }
            }
        }
        
        stage('Verify GPG Signature') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'gpg-public-key',
                        variable: 'PUBLIC_KEY'
                    )
                ]) {
                    sh '''
                        gpg --import "$PUBLIC_KEY"
        
                        gpg --verify \
                            artifact/app.jar.asc \
                            artifact/app.jar
                    '''
                }
            }
        }
        
        stage('Prepare Docker Context') {
            steps {
                sh '''
                    cp artifact/app.jar app.jar
        
                    echo "Workspace contents:"
                    ls -lh
                '''
            }
        }
        
        stage('Check Relevant Changes') {
            steps {
                script {
                    def changedFiles = sh(
                        script: "git diff --name-only HEAD~1 HEAD",
                        returnStdout: true
                    ).trim()
        
                    echo "Changed files:\n${changedFiles}"
        
                    def shouldBuild =
                        changedFiles =~ /(src\/|pom\.xml|Dockerfile|mvnw|\.dockerignore)/
        
                    env.BUILD_IMAGE = shouldBuild ? "true" : "false"
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                        -t rajkumardubey10/spring-petclinic:${SHORT_SHA} .
                '''
            }
        }
    }
}