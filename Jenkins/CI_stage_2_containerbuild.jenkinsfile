pipeline {
    agent any


    parameters {
    string(name: 'ARTIFACT_NAME', defaultValue: '', description: 'Artifact Name')
    string(name: 'RESOLVED_VERSION', defaultValue: '', description: 'Resolved Maven Version')
    string(name: 'DOWNLOAD_URL', defaultValue: '', description: 'Artifact Download URL')
    }

    tools {
        jdk 'JDK17'
        
    }

    stages {
        
        stage('Git Checkout') {
            steps {
                git branch: 'main', credentialsId: 'Github-token', url: 'https://github.com/rajkumardubey10/enterprise-jenkins-devsecops.git'
            }
        }

        stage('Read Artifact Metadata') {
            steps {
                script {
                    if (!params.DOWNLOAD_URL || !params.RESOLVED_VERSION || !params.ARTIFACT_NAME) {
                        error "Required artifact metadata was not provided by CI Stage 1."
                    }
                    env.ARTIFACT_NAME = params.ARTIFACT_NAME
                    env.RESOLVED_VERSION = params.RESOLVED_VERSION
                    env.DOWNLOAD_URL = params.DOWNLOAD_URL

                    echo "Artifact Name     : ${env.ARTIFACT_NAME}"
                    echo "Resolved Version  : ${env.RESOLVED_VERSION}"
                    echo "Download URL      : ${env.DOWNLOAD_URL}"
                }
            }
        }
        
        stage('Download Signed Artifact') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh '''
                    mkdir -p artifact

                    curl -u "$NEXUS_USER:$NEXUS_PASS" \
                        -o artifact/app.jar \
                        "$DOWNLOAD_URL"

                    curl -u "$NEXUS_USER:$NEXUS_PASS" \
                        -o artifact/app.jar.asc \
                        "${DOWNLOAD_URL}.asc"
                    '''
                }
            }
        }
        
        stage('Verify GPG Signature') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'gpg-public-key',
                        variable: 'PUBLIC_KEY'
                    )
                ]) {
                    sh '''
                        gpg --import "$PUBLIC_KEY"
        
                        gpg --verify \
                            artifact/app.jar.asc \
                            artifact/app.jar
                    '''
                }
            }
        }
        
        stage('Prepare Docker Context') {
            steps {
                sh '''
                    cp artifact/app.jar app.jar
        
                    echo "Workspace contents:"
                    ls -lh
                '''
            }
        }
        
        
        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                        -t rajkumardubey10/spring-petclinic:${RESOLVED_VERSION} \
                        -t rajkumardubey10/spring-petclinic:latest \
                        .
                '''
            }
        }
        stage('Generate Image SBOM') {
            steps {
                sh '''
               set -e

            IMAGE="rajkumardubey10/spring-petclinic:${RESOLVED_VERSION}"

            echo "Generating SBOM for Docker image:"
            echo "$IMAGE"

            mkdir -p security

            trivy image \
                --format cyclonedx \
                --output security/image-sbom.json \
                "$IMAGE"

            echo "Image SBOM generated successfully."

            ls -lh security/image-sbom.json
        '''
    }
}
    }
}
