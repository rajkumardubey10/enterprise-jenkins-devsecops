pipeline {
    agent any
    
    tools {
        jdk 'JDK17'
        
    }

    environment {
        MAVEN_OPTS = '-Dgpg.pinentry-mode=loopback'

        NEXUS_URL = "http://localhost:8081"

        NEXUS_REPOSITORY = "maven-snapshots"
    }

    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'main', credentialsId: 'Github-token', url: 'https://github.com/rajkumardubey10/enterprise-jenkins-devsecops.git'
            }
        }


        stage('Import GPG Key') {
            steps {
                withCredentials([
                    file(credentialsId: 'gpg-private-key', variable: 'GPG_KEY')
                ]) {
                    sh '''
                        gpg --batch --import "$GPG_KEY"
                    '''
                }
            }
        }
        
        stage('Secret Scan - Gitleaks') {
            steps {
                sh '''
                 gitleaks detect --source . -r report-gitleaks.txt \
                 --exit-code 1
                '''
            }
        }
        stage('Prepare Build') {
            steps {
               sh 'chmod +x mvnw'
            }
        }
        
        stage('Build, Test & Sign') {
            steps {

                withCredentials([
                    string(credentialsId: 'gpg-passphrase', variable: 'GPG_PASSPHRASE'),
                    string(credentialsId: 'gpg-key-id', variable: 'GPG_KEY_ID')
                ]) {

                    sh '''
                    ./mvnw clean verify \
                      -Dgpg.passphrase="$GPG_PASSPHRASE" \
                      -Dgpg.keyname="$GPG_KEY_ID"
                    '''
                }

            }
        }
        
    
        
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('Sonar') {

                    sh '''
                    ./mvnw sonar:sonar \
                    -Dsonar.projectKey=My-project
                    '''
                }
            }
        }
        
    
        
        stage('Quality Gate') {

            steps {

                timeout(time: 5, unit: 'MINUTES') {

                    waitForQualityGate abortPipeline: true, credentialsId: 'sonar-token'

                }
            }
        }

        stage('Validate SBOM') {
            steps {
                sh '''
                test -f target/classes/META-INF/sbom/application.cdx.json
                '''
            }
        }

        stage('Trivy SBOM Scan') {
            steps {
                sh '''
                trivy sbom target/classes/META-INF/sbom/application.cdx.json \
                --timeout 15m \
                --format json \
                --output trivy-sbom-report.json \
                --severity HIGH,CRITICAL \
                --exit-code 0
                '''
            }
        }

        

        stage('Publish Artifact to Nexus') {
            steps {

                withCredentials([
                    string(credentialsId: 'gpg-passphrase', variable: 'GPG_PASSPHRASE'),
                    string(credentialsId: 'gpg-key-id', variable: 'GPG_KEY_ID')
                ]) {

                    configFileProvider([
                        configFile(
                            fileId: 'Nexus-Credential',
                            variable: 'nexus_artifactory_upload'
                        )
                    ]) {

                        sh '''
                            ./mvnw deploy \
                                -s "$nexus_artifactory_upload" \
                                -DskipTests=true \
                                -Dgpg.passphrase="$GPG_PASSPHRASE" \
                                -Dgpg.keyname="$GPG_KEY_ID"
                        '''
                    }
                }
            }
        }

        stage('Capture Artifact Metadata') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    script {

                        // Read Maven coordinates
                        def groupId = sh(
                            script: "./mvnw help:evaluate -Dexpression=project.groupId -q -DforceStdout",
                            returnStdout: true
                        ).trim()

                        def artifactId = sh(
                            script: "./mvnw help:evaluate -Dexpression=project.artifactId -q -DforceStdout",
                            returnStdout: true
                        ).trim()

                        def baseVersion = sh(
                            script: "./mvnw help:evaluate -Dexpression=project.version -q -DforceStdout",
                            returnStdout: true
                        ).trim()

                        def releaseVersion = baseVersion.replace("-SNAPSHOT", "")
                        def groupPath = groupId.replace('.', '/')

                        def metadataUrl =
                            "${env.NEXUS_URL}/repository/${env.NEXUS_REPOSITORY}/${groupPath}/${artifactId}/${baseVersion}/maven-metadata.xml"

                        echo "Reading Nexus metadata..."
                        echo metadataUrl

                        // Download metadata.xml
                        sh """
                            curl -u "$NEXUS_USER:$NEXUS_PASS" \
                                -fsSL \
                                "${metadataUrl}" \
                                -o metadata.xml
                        """

                        // Extract values without XmlSlurper
                        def timestamp = sh(
                            script: "grep -oPm1 '(?<=<timestamp>)[^<]+' metadata.xml",
                            returnStdout: true
                        ).trim()

                        def buildNumber = sh(
                            script: "grep -oPm1 '(?<=<buildNumber>)[^<]+' metadata.xml",
                            returnStdout: true
                        ).trim()

                        if (!timestamp || !buildNumber) {
                            error "Unable to parse snapshot metadata from metadata.xml"
                        }

                        def resolvedVersion = "${releaseVersion}-${timestamp}-${buildNumber}"

                        def artifactName =
                            "${artifactId}-${resolvedVersion}.jar"

                        def downloadUrl =
                            "${env.NEXUS_URL}/repository/${env.NEXUS_REPOSITORY}/${groupPath}/${artifactId}/${baseVersion}/${artifactName}"

                        env.ARTIFACT_NAME = artifactName
                        env.RESOLVED_VERSION = resolvedVersion
                        env.DOWNLOAD_URL = downloadUrl


                        def jsonContent = """
                        {
                        "artifactName": "${artifactName}",
                        "resolvedVersion": "${resolvedVersion}",
                        "repository": "${env.NEXUS_REPOSITORY}",
                        "downloadUrl": "${downloadUrl}"
                        }
                        """

                        writeFile(
                            file: 'artifact-metadata.json',
                            text: jsonContent
                        )

                        archiveArtifacts(
                            artifacts: 'artifact-metadata.json',
                            fingerprint: true
                        )

                        echo """
        ===================================================

        Artifact Name     : ${artifactName}
        Resolved Version  : ${resolvedVersion}
        Repository        : ${env.NEXUS_REPOSITORY}
        Download URL      : ${downloadUrl}

        ===================================================
        """
                    }
                }
            }
        }

        stage('Trigger CI Stage 2') {
            steps {
                script {
                    build job: 'CI-Pipeline-stage-2 (Container Build and Security)',
                        wait: false,
                        parameters: [
                            string(name: 'ARTIFACT_NAME', value: env.ARTIFACT_NAME),
                            string(name: 'RESOLVED_VERSION', value: env.RESOLVED_VERSION),
                            string(name: 'DOWNLOAD_URL', value: env.DOWNLOAD_URL)
                        ]
                }
            }
        }
        
        
    }
}
