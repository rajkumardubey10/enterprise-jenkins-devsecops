pipeline {
    agent any
    
    tools {
        jdk 'JDK17'
        
    }

    environment {
        MAVEN_OPTS = '-Dgpg.pinentry-mode=loopback'
    }

    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'main', credentialsId: 'Github-token', url: 'https://github.com/rajkumardubey10/enterprise-jenkins-devsecops.git'
            }
        }


        stage('Import GPG Key') {
            steps {
                withCredentials([
                    file(credentialsId: 'gpg-private-key', variable: 'GPG_KEY')
                ]) {
                    sh '''
                        gpg --batch --import "$GPG_KEY"
                    '''
                }
            }
        }
        
        stage('Secret Scan - Gitleaks') {
            steps {
                sh '''
                 gitleaks detect --source . -r report-gitleaks.txt \
                 --exit-code 1
                '''
            }
        }
        stage('Prepare Build') {
            steps {
               sh 'chmod +x mvnw'
            }
        }
        
        stage('Build, Test & Sign') {
            steps {

                withCredentials([
                    string(credentialsId: 'gpg-passphrase', variable: 'GPG_PASSPHRASE'),
                    string(credentialsId: 'gpg-key-id', variable: 'GPG_KEY_ID')
                ]) {

                    sh '''
                    ./mvnw clean verify \
                      -Dgpg.passphrase="$GPG_PASSPHRASE" \
                      -Dgpg.keyname="$GPG_KEY_ID"
                    '''
                }

            }
        }
        
    
        
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('Sonar') {

                    sh '''
                    ./mvnw sonar:sonar \
                    -Dsonar.projectKey=My-project
                    '''
                }
            }
        }
        
    
        
        stage('Quality Gate') {

            steps {

                timeout(time: 5, unit: 'MINUTES') {

                    waitForQualityGate abortPipeline: true, credentialsId: 'sonar-token'

                }
            }
        }

        stage('Trivy SBOM Scan') {
            steps {
                sh '''
                trivy sbom target/classes/META-INF/sbom/application.cdx.json \
                --timeout 15m \
                --format json \
                --output trivy-sbom-report.json \
                --severity HIGH,CRITICAL \
                --exit-code 1
                '''
            }
        }

        

        stage('Publish Artifact to Nexus') {
            steps {
                configFileProvider([configFile(fileId: 'Nexus-Credential', variable: 'nexus_artifactory_upload')]) {
                    sh '''
                        ./mvnw deploy -s "$nexus_artifactory_upload" \
                        -DskipTests=true \
                        
                    '''
            } 
            }
        }

        stage('Capture Artifact Metadata') {
            steps {
                script {

                    // Git Commit SHA
                    env.GIT_SHA = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    // Maven Project Version
                    env.PROJECT_VERSION = sh(
                        script: "./mvnw help:evaluate -Dexpression=project.version -q -DforceStdout",
                        returnStdout: true
                    ).trim()

                    // Artifact Name
                    env.ARTIFACT_ID = sh(
                        script: "./mvnw help:evaluate -Dexpression=project.artifactId -q -DforceStdout",
                        returnStdout: true
                    ).trim()

                    echo """ 
        ================ Artifact Metadata ================

        Git SHA          : ${env.GIT_SHA}
        Artifact ID      : ${env.ARTIFACT_ID}
        Project Version  : ${env.PROJECT_VERSION}
        Build Number     : ${env.BUILD_NUMBER}

        ===================================================
        """
                }
            }
        }
        
        
    }
}
